{
  // Reemplaza a partykit.json (ver docs/PRE-PROD.md Fase 5) — el CLI de
  // "partykit" (plataforma gestionada partykit.dev) quedó congelado en
  // v0.0.115 y no soporta el requisito nuevo de Cloudflare de migraciones
  // `new_sqlite_classes` para Durable Objects en el plan gratuito. Cloudflare
  // compró PartyKit (abril 2024) y mantiene activamente "partyserver", que
  // corre directo sobre Wrangler/Durable Objects nativos con la misma forma
  // de API — ver party/gameRoom.ts y party/directory.ts.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planet-scape",
  "main": "party/worker.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    // "MAIN" (no "GAME_ROOM"): routePartykitRequest deriva el segmento de
    // URL del binding en kebab-case (MAIN → "main") — el cliente
    // (partysocket, ver lib/multiplayer/useRoomConnection.ts) ya se conecta
    // a `/parties/main/{roomId}` por defecto (no pasa `party` explícito), y
    // así no hace falta tocar el cliente para que coincida.
    "bindings": [
      { "name": "MAIN", "class_name": "GameRoom" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom", "Directory"]
    }
  ]
  // APP_ORIGIN y PARTYKIT_SHARED_SECRET NO viven aquí — se manejan como
  // secrets vía `wrangler secret put` (ver docs/PRE-PROD.md Fase 5/7):
  // - En desarrollo, `wrangler dev` los toma de .env.local automáticamente.
  // - En producción, quedan cifrados en el Worker, nunca en texto plano en
  //   este archivo versionado.
}
