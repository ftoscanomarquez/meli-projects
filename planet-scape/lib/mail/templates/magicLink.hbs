<!DOCTYPE html>
<html lang="{{locale}}">
  <body style="margin:0;padding:0;background:#0b0e1a;font-family:'Segoe UI',Helvetica,Arial,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#0b0e1a;padding:32px 0;">
      <tr>
        <td align="center">
          <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="background:#141830;border-radius:16px;padding:32px;">
            <tr>
              <td align="center" style="padding-bottom:16px;">
                <div style="font-size:40px;">🪐</div>
                <h1 style="color:#ffffff;font-size:22px;margin:8px 0 0;">{{appName}}</h1>
              </td>
            </tr>
            <tr>
              <td style="color:#c7cbe8;font-size:15px;line-height:1.6;padding-bottom:24px;">
                {{greeting}}
              </td>
            </tr>
            <tr>
              <td align="center" style="padding-bottom:8px;">
                <div style="color:#8a8fb8;font-size:13px;text-transform:uppercase;letter-spacing:1px;">{{codeLabel}}</div>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding-bottom:24px;">
                <div style="display:inline-block;background:#1c2142;border:1px solid #2c3364;border-radius:12px;
                            padding:16px 28px;font-family:'Courier New',monospace;
                            font-size:36px;font-weight:700;letter-spacing:10px;color:#ffc93c;">
                  {{code}}
                </div>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding-bottom:24px;">
                <a href="{{magicLinkUrl}}"
                   style="display:inline-block;background:#5b6cff;color:#ffffff;text-decoration:none;
                          font-weight:600;font-size:16px;padding:14px 32px;border-radius:999px;">
                  {{ctaLabel}}
                </a>
              </td>
            </tr>
            <tr>
              <td style="color:#8a8fb8;font-size:13px;line-height:1.5;">
                {{expiryNotice}}
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
