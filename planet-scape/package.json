{
  "name": "planet-scape",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:party": "tsc --noEmit -p party/tsconfig.json",
    "party:dev": "wrangler dev --port 1999 --ip 0.0.0.0",
    "party:deploy": "wrangler deploy",
    "seed:schema": "tsx --env-file=.env.local scripts/seeds/seed-schema.ts",
    "seed:config": "tsx --env-file=.env.local scripts/seeds/seed-config.ts",
    "seed:admins": "tsx --env-file=.env.local scripts/seeds/seed-admins.ts",
    "seed:admin": "tsx --env-file=.env.local scripts/seeds/promote-admin.ts",
    "seed": "npm run seed:schema && npm run seed:config && npm run seed:admins",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:api": "newman run tests/postman/PlanetScape.postman_collection.json -e tests/postman/PlanetScape.local.postman_environment.json",
    "test:api:report": "newman run tests/postman/PlanetScape.postman_collection.json -e tests/postman/PlanetScape.local.postman_environment.json -r htmlextra --reporter-htmlextra-export tests/postman/report.html",
    "test:load": "k6 run tests/load/http.k6.js",
    "test:load:ws": "k6 run tests/load/partykit.k6.js"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.11.3",
    "handlebars": "^4.7.9",
    "mongodb": "^6.21.0",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.13.3",
    "nodemailer": "^8.0.11",
    "partyserver": "^0.5.8",
    "partysocket": "^1.3.0",
    "pino": "^10.3.1",
    "pixi.js": "^8.19.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.3.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260726.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "partyserver": {
      "@cloudflare/workers-types": "$@cloudflare/workers-types"
    }
  }
}
