# Ver INFRA.md §3 — copiar a .env.local y completar. Nunca commitear valores reales.

# Base de datos — "planet_scape" es el nombre de la BD en Mongo (ver AGENTS.md §7, lib/db.ts)
MONGODB_URI=mongodb://admin:magiclink123@localhost:27019/?authSource=admin
MONGODB_DB=planet_scape

# Auth.js / Magic Link (Fase 1)
AUTH_SECRET=
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_USER=admin
EMAIL_SERVER_PASSWORD=magiclink123
EMAIL_FROM=noreply@planetscape.local

# Mailpit (solo referencia UI local)
MAILPIT_UI_URL=http://localhost:8025

# Solo pruebas locales — entra de inmediato sin revisar Mailpit (sigue
# mandando el correo real, solo automatiza el clic) — ver
# lib/dev/mailpitAutoLogin.ts. Dejar en false o sin definir; NUNCA activar
# en producción (ver DEPLOYMENT.md).
DEV_AUTO_LOGIN=false

# i18n
NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_LOCALES=es,en

# Stripe (Fase 7)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# WhatsApp Business de Francisco, mostrado al final de cada partida (ver AGENTS.md §10)
# Ejemplo real: https://wa.me/message/VHN4K4UW4WMAH1 (link corto de WhatsApp Business)
NEXT_PUBLIC_WHATSAPP_LINK=

# WhatsApp Cloud API (Meta) — SOLO para el envío automático de recuperación
# de cuenta (ver AGENTS.md §6.7, lib/whatsapp.ts). Sin estas dos variables,
# la recuperación de cuenta sigue funcionando pero solo registra en el log
# que se habría enviado el mensaje — no llega de verdad a ningún celular.
# Requiere un número de WhatsApp Business verificado en Meta for Developers.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# PartyKit (Fase 5). PARTYKIT_SHARED_SECRET también debe copiarse a
# party/.env (el runtime de PartyKit no lee .env.local) para que
# party/gameRoom.ts pueda autenticar sus llamadas a /api/chat/log — ver
# AGENTS.md §6.6 (moderación de chat/denuncias).
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999
PARTYKIT_SHARED_SECRET=
# URL pública de la app Next.js, usada por party/gameRoom.ts para persistir
# el chat en Mongo vía /api/chat/log — ver AGENTS.md §6.6.
APP_ORIGIN=http://localhost:3000

# Rate limiting (opcional — fallback en memoria si se omite, ver lib/resilience/rateLimit.ts)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Logging
PINO_LOG_LEVEL=info
